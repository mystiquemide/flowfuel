# Application
APP_URL=http://localhost:3000
NODE_ENV=development
FLOWFUEL_COMMIT_SHA=development
# Production deployment replaces this with the full 40-character git HEAD.

# Database
DATABASE_URL=postgresql://flowfuel:flowfuel@localhost:55432/flowfuel

# Credential encryption
# 32 random bytes encoded as 64 hexadecimal characters.
CREDENTIAL_ENCRYPTION_KEY=

# Agency and n8n authentication
# Use independent random values. Never reuse wallet or provider secrets.
AGENCY_SESSION_SECRET=
AGENCY_PASSWORD=
CLIENT_SESSION_SECRET=
# Bearer token n8n sends when calling POST /api/runs on the broker or web app.
FLOWFUEL_WORKFLOW_TOKEN=
# URL n8n uses to reach the broker. Inside docker-compose this resolves
# through host.docker.internal to the host process.
FLOWFUEL_BROKER_URL=http://host.docker.internal:4010
# Comma-separated run UUIDs intentionally exposed on /proof and public receipts.
PUBLIC_PROOF_RUN_IDS=

# Broker server (standalone apps/broker deployment)
BROKER_PORT=4010

# Orbio and Robinhood Chain
ORBIO_GATEWAY_URL=https://www.orbio.so/api/v1
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
CREDIT_CONTRACT_ADDRESS=0xe33322da1380e61e5ae5dfb21e7f62924c73004c

# Optional public explorer prefix
ROBINHOOD_EXPLORER_URL=https://robin.etherscan.io

# Observability
LOG_LEVEL=info
