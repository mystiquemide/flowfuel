{
  "name": "FlowFuel client-funded Lead Intelligence Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "flowfuel-run",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "f0f4a2f8-9f00-4c96-9b1d-flowfuel0001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-520, 300],
      "webhookId": "flowfuel-run"
    },
    {
      "parameters": {
        "jsCode": "// One shared Lead Intelligence Agent for every client.\n// Input identifies a company and includes its public website URL.\nconst body = $json.body ?? {};\nconst clientIds = Array.isArray(body.clientIds) && body.clientIds.length > 0\n  ? body.clientIds\n  : typeof body.clientId === \"string\" && body.clientId.length > 0\n    ? [body.clientId]\n    : [];\nif (clientIds.length === 0) throw new Error(\"clientId or clientIds is required\");\nfor (const id of clientIds) if (typeof id !== \"string\" || !id) throw new Error(\"each clientId must be a non-empty string\");\nif (typeof body.input !== \"string\" || !body.input) throw new Error(\"input is required\");\nconst input = body.input.slice(0, 8000);\nconst maxOutputTokens = Math.min(Math.max(Number(body.maxOutputTokens) || 700, 1), 1200);\nreturn clientIds.map((clientId) => ({ json: { clientId, workflowRunId: String($execution.id), task: { type: \"lead_intelligence\", input }, model: \"google/gemini-2.5-flash\", maxOutputTokens } }));\n"
      },
      "id": "a1b2c3d4-0000-4c96-9b1d-flowfuel0002",
      "name": "Build Run Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-300, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FLOWFUEL_BROKER_URL }}/api/runs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.FLOWFUEL_WORKFLOW_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": false
            }
          },
          "timeout": 60000
        }
      },
      "id": "b2c3d4e5-0000-4c96-9b1d-flowfuel0003",
      "name": "FlowFuel Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-60, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-succeeded",
              "leftValue": "={{ $json.status }}",
              "rightValue": "succeeded",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c3d4e5f6-0000-4c96-9b1d-flowfuel0004",
      "name": "Funded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [160, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ (() => { const decision = JSON.parse($json.result); return JSON.stringify({ runId: $json.runId, status: $json.status, decision, nextAction: decision.qualification === 'high' ? 'route_to_sales' : 'manual_review', taskHash: $json.receipt.taskHash, receipt: $json.receipt }); })() }}",
        "options": {}
      },
      "id": "d4e5f6a7-0000-4c96-9b1d-flowfuel0005",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [420, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ runId: $json.runId, status: $json.status, taskHash: $json.taskHash, error: $json.error, fundingRequired: $json.status === 'client_unfunded' || $json.status === 'quota_exceeded' }) }}",
        "options": {
          "responseCode": 422
        }
      },
      "id": "e5f6a7b8-0000-4c96-9b1d-flowfuel0006",
      "name": "Respond Funding Required",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [420, 400]
    }
  ],
  "connections": {
